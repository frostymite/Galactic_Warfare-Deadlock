      "source": "ship.palette + ship.markings",
      "change": "hull paint, trim, Apex/registry markings; never changes geometry"
    },
    "local_damage": {
      "source": "component instance condition",
      "change": "zone-local scorching, dents, missing panels, flicker/venting without changing installed part identity"
    },
    "emissive": {
      "source": "engine/utility/weapon state",
      "change": "cyan engine, sensor, cockpit and weapon-ready lighting"
    }

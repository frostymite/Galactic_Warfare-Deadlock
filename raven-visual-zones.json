    {
      "min": 85,
      "max": 100,
      "state": "operational"
    },
    {
      "min": 65,
      "max": 84,
      "state": "worn"
    },
    {
      "min": 40,
      "max": 64,
      "state": "damaged"
    },
    {
      "min": 1,
      "max": 39,
      "state": "critical"
    },
    {
      "min": 0,
      "max": 0,
      "state": "destroyed"
    }
  ],
  "resolver": {
    "sourceOfTruth": "DeadlockShipForge.blueprint(DATA,'raven') + DATA.shipForge.components installation condition",
    "rule": "Installed ShipForge part IDs select Raven-specific zone layers. No separate visual upgrade inventory.",
    "pseudocode": [
      "ship = DeadlockShipForge.shipRecord(DATA,'raven')",
      "blueprint = DeadlockShipForge.blueprint(DATA,ship)",
      "for each installed slot -> partId -> partMap[partId] -> view layer",
      "apply palette/markings mask",
      "apply condition-local damage overlay by installed component instance",
      "compose in view.compositeOrder",
      "fallback to legacy Raven image only if a required hero layer is unavailable"
    ]
  },
  "legacyAssetsToReplace": [
    "assets/ships/raven_cutout_v15.svg",
    "assets/ships/raven_vector_v15.svg",
    "assets/ships/raven_flight.svg",
    "assets/ships/raven_landed.svg",
    "assets/ships/raven_orbit.svg",
    "assets/ships/raven_schematic.svg",
    "assets/raven.jpg",
    "assets/raven_dedicated.jpg"
  ],
  "runtimeTargets": {
    "currentStaticFunction": "app.js::ravenVisual(state)",
    "futureModule": "runtime/raven-visual.js",
    "primaryIntegration": [
      "Ship page hero",
      "Blackglass hangar Raven hotspot/presentation",
      "Flight/Orbit hero callouts",
      "Dogfight Raven presentation",
      "cinematic ship shots"
    ],
    "preserve": [
      "DeadlockShipForge persistence/economy",
      "component installation IDs",
      "existing derived stats",
      "save-game schema"
    ],
    "currentModule": "runtime/raven-visual.js",
    "currentRenderer": "live ShipForge generated-art assembly",
    "staticFallback": "assets/ships/raven_cutout_v15.svg",
    "behavior": "Normal Raven hero views now render the actual installed ShipForge blueprint. Schematic remains dedicated schematic art."
  },
  "coverage": {
    "hero_3q": {
      "requiredAllCompatibleParts": true,
      "partCount": 36,
      "rendererGate": "do not enable realistic hero resolver until every compatible light_freighter part has a Raven hero layer or an explicitly approved Raven-specific fallback"
    },
    "secondaryViews": {
      "policy": "ship identity/current-loadout first; expand per-part coverage after hero_3q is complete"
    }
  },

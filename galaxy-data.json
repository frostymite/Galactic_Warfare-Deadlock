  "hq": {
    "name": "Deadlock HQ",
    "stationId": "blackglass_station",
    "description": "Rovan Kes maintains a secure operations suite inside Blackglass Station. It serves as a briefing room, contract intake point, equipment staging area, and personal safe harbor.",
